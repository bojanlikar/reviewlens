# ---- Required -------------------------------------------------------------
# Review page to ingest (one entity per deployment). The adapter is picked from the URL:
#   Apple App Store: https://apps.apple.com/<country>/app/<name>/id<appId>   (recommended)
#   Trustpilot:      https://www.trustpilot.com/review/<domain>              (often blocked, see README)
REVIEW_SOURCE_URL=https://store.steampowered.com/app/620/Portal_2/
# Offline fallback if the platform blocks scraping (takes priority over the URL).
# A folder of saved .html pages, one .html page, or a .json file, under ./data (mounted at /data)
# REVIEW_SOURCE_FILE=/data/reviews
# Public hostname served through the Cloudflare tunnel (no scheme)
PUBLIC_HOSTNAME=xyz.example.com
# Anthropic API key used by the API service
ANTHROPIC_API_KEY=sk-ant-...

# ---- Recommended ----------------------------------------------------------
# Shared secret between Open WebUI and the API (generate: openssl rand -hex 24)
LLM_GATEWAY_KEY=change-me
# Cloudflare tunnel token (only used with: docker compose --profile tunnel up)
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Optional tuning ------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5-5
# SNAPSHOT_PATH=./state/snapshot.json   # where the last good ingestion is saved (set by compose in Docker)
MAX_PAGES=10            # pages to ingest, newest first (App Store: 50/page, max 10; Trustpilot: 20/page)
REFRESH_MIN_AGE_HOURS=6   # on startup, skip re-fetching if the saved data is younger than this (0 = always refresh); /reingest forces one
MAX_CONTEXT_CHARS=350000
MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=120000   # give up on the model after this long (ms)
WEBUI_PORT=4000         # host port bound on 127.0.0.1 for Open WebUI
